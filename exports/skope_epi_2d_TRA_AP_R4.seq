# Format of RF events:
# id amplitude mag_id phase_id time_shape_id delay freq phase
# ..        Hz   ....     ....          ....    us   Hz   rad
[RF]
1       502.45 7 8 0 130 -49000 307.876
2       502.45 7 8 0 130 -42000 263.894
3       502.45 7 8 0 130 -35000 219.911
4       502.45 7 8 0 130 -28000 175.929
5       502.45 7 8 0 130 -21000 131.947
6       502.45 7 8 0 130 -14000 87.9646
7       502.45 7 8 0 130 -7000 43.9823
8       502.45 7 8 0 130 0 -0
9       502.45 7 8 0 130 7000 -43.9823
10       502.45 7 8 0 130 14000 -87.9646
11       502.45 7 8 0 130 21000 -131.947
12       502.45 7 8 0 130 28000 -175.929
13       502.45 7 8 0 130 35000 -219.911
14       502.45 7 8 0 130 42000 -263.894
15       502.45 7 8 0 130 49000 -307.876

# Format of arbitrary gradients:
#   time_shape_id of 0 means default timing (stepping with grad_raster starting at 1/2 of grad_raster)
# id amplitude amp_shape_id time_shape_id delay
# ..      Hz/m       ..         ..          us
[GRADIENTS]
6      -200000 1 2 910
8      -200000 3 4 0
9      -200000 5 6 0

# Format of trapezoid gradients:
# id amplitude rise flat fall delay
# ..      Hz/m   us   us   us    us
[TRAP]
 1       666667 130 2000 130   0
 2 -1.97222e+06 360    0 360   0
 3  1.68368e+06 310    0 310   0
 4       901818 170  380 170   0
 5 -1.49126e+06 270  430 270   0
 7  1.49126e+06 270  430 270   0

# Format of ADC events:
# id num dwell delay freq phase
# ..  ..    ns    us   Hz   rad
[ADC]
1 324 2600 64 0 0

# Format of extension lists:
# id type ref next_id
# next_id of 0 terminates the list
# Extension list is followed by extension specifications
[EXTENSIONS]
1 1 1 0
2 2 1 0
3 1 2 0
4 1 3 3
5 1 4 4
6 1 5 5
7 1 6 6
