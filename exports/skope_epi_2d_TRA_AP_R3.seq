# id amplitude mag_id phase_id time_shape_id delay freq phase
# ..        Hz   ....     ....          ....    us   Hz   rad
[RF]
1       502.45 6 7 0 100 -14000 87.9646
2       502.45 6 7 0 100 -7000 43.9823
3       502.45 6 7 0 100 0 -0
4       502.45 6 7 0 100 7000 -43.9823
5       502.45 6 7 0 100 14000 -87.9646

# Format of arbitrary gradients:
#   time_shape_id of 0 means default timing (stepping with grad_raster starting at 1/2 of grad_raster)
# id amplitude amp_shape_id time_shape_id delay
# ..      Hz/m       ..         ..          us
[GRADIENTS]
6      -300000 1 2 720
8      -300000 3 4 0
9      -300000 5 2 0

# Format of trapezoid gradients:
# id amplitude rise flat fall delay
# ..      Hz/m   us   us   us    us
[TRAP]
 1       666667  90 2000  90  10
 2 -2.24731e+06 310    0 310   0
 3  1.91882e+06 270    0 270   0
 4     1.05e+06 140  340 140   0
 5  -2.2046e+06 290  180 290   0
 7   2.2046e+06 290  180 290   0

# Format of ADC events:
# id num dwell delay freq phase
# ..  ..    ns    us   Hz   rad
[ADC]
1 376 1800 42 0 0

